# Enterprise Brain Environment Configuration

# Application
ENVIRONMENT=development
PROJECT_NAME="Enterprise Brain"
API_V1_STR="/api"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database
# Default is PostgreSQL with pgvector; if PostgreSQL is offline in local dev/testing,
# the backend gracefully uses a local vector-capable SQLite engine.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_brain

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-2.5-flash

# Authentication (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks

# Ingestion & Chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=120
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR="./uploads"

