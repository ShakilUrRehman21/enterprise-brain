# Copy to .env (project root or backend/) and adjust.

# development | production. Production refuses to start with the default SECRET_KEY.
ENVIRONMENT=development

# Signs login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# SQLite by default (stored in backend/data/). For production use Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/enterprise_brain
DATABASE_URL=sqlite:///./data/enterprise_brain.db
UPLOAD_DIR=./data/uploads

# Who may call the API directly from a browser (only needed if the frontend
# calls the backend cross-origin via NEXT_PUBLIC_API_URL).
BACKEND_CORS_ORIGINS=http://localhost:3000

# Sign-up. The first account always becomes admin. Set false to make the
# workspace invite-only (admins then create accounts with `python -m app.manage`).
ALLOW_REGISTRATION=true
# Optional: create this admin on startup if it doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google Gemini. Leave empty to run fully offline (quoted answers, local search).
GEMINI_API_KEY=
# auto (default) works with both Gemini Developer API keys and Vertex AI express keys.
GEMINI_BACKEND=auto
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ingestion and answering
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=350
CHUNK_OVERLAP=60
RETRIEVAL_TOP_K=6
MIN_QUERY_COVERAGE=0.6
